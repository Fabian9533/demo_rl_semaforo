<routes>
    <!-- mix_red (plan 3; lo escribe demanda_estocastica.py preparar3, no editar a mano): red.rou.xml con llegadas de Poisson (vehsPerHour q pasa a period exp(q/3600); mismo begin y end); mezcla de Lima (vTypeDistribution auto: JICA 2013 sin camiones y flota ATU 2021) con los mismos vehiculos equivalentes del INVERMET (tasas x 0.837802 = 1/1.193600); entrada por el mejor carril (departLane best en cada flow). -->
    <vTypeDistribution id="auto">
        <vType id="lima_auto" accel="2.6" decel="4.5" length="5" sigma="0.5" minGap="2.5" maxSpeed="13.89" probability="0.789283"/>
        <vType id="lima_moto" vClass="motorcycle" accel="6" decel="10" length="2.2" sigma="0.5" minGap="2.5" maxSpeed="13.89" probability="0.043643"/>
        <vType id="lima_combi" vClass="bus" accel="2" decel="4.5" length="6" sigma="0.5" minGap="2.5" maxSpeed="13.89" probability="0.048078"/>
        <vType id="lima_micro" vClass="bus" accel="1.5" decel="4" length="8" sigma="0.5" minGap="2.5" maxSpeed="13.89" probability="0.056413"/>
        <vType id="lima_bus" vClass="bus" accel="1.2" decel="4" length="12" sigma="0.5" minGap="2.5" maxSpeed="13.89" probability="0.062584"/>
    </vTypeDistribution>

    <!-- Demanda muy asimetrica: la avenida carga mucho mas que las transversales.
         Periodo 1 (0-1800 s): hora punta de oeste a este -->
    <flow id="p1_W_E"   type="auto" from="W_RW"  to="C3_E"  begin="0" end="1800" period="exp(0.151269752197)" departLane="best"/>
    <flow id="p1_E_W"   type="auto" from="E_C3"  to="RW_W"  begin="0" end="1800" period="exp(0.0581806739217)" departLane="best"/>
    <flow id="p1_SR_E"  type="auto" from="SR_RS" to="C3_E"  begin="0" end="1800" period="exp(0.0349084043531)" departLane="best"/>
    <flow id="p1_W_NR"  type="auto" from="W_RW"  to="RN_NR" begin="0" end="1800" period="exp(0.0186178156549)" departLane="best"/>
    <flow id="p1_N1_S1" type="auto" from="N1_C1" to="C1_S1" begin="0" end="1800" period="exp(0.0349084043531)" departLane="best"/>
    <flow id="p1_S1_N1" type="auto" from="S1_C1" to="C1_N1" begin="0" end="1800" period="exp(0.0349084043531)" departLane="best"/>
    <flow id="p1_N2_S2" type="auto" from="N2_C2" to="C2_S2" begin="0" end="1800" period="exp(0.0349084043531)" departLane="best"/>
    <flow id="p1_S2_N2" type="auto" from="S2_C2" to="C2_N2" begin="0" end="1800" period="exp(0.0349084043531)" departLane="best"/>
    <flow id="p1_N3_S3" type="auto" from="N3_C3" to="C3_S3" begin="0" end="1800" period="exp(0.0349084043531)" departLane="best"/>
    <flow id="p1_S3_N3" type="auto" from="S3_C3" to="C3_N3" begin="0" end="1800" period="exp(0.0349084043531)" departLane="best"/>
    <flow id="p1_S1_E"  type="auto" from="S1_C1" to="C3_E"  begin="0" end="1800" period="exp(0.0139633617412)" departLane="best"/>
    <flow id="p1_N3_W"  type="auto" from="N3_C3" to="RW_W"  begin="0" end="1800" period="exp(0.0139633617412)" departLane="best"/>

    <!-- Periodo 2 (1800-3600 s): la punta se invierte, de este a oeste -->
    <flow id="p2_W_E"   type="auto" from="W_RW"  to="C3_E"  begin="1800" end="3600" period="exp(0.0581806739217)" departLane="best"/>
    <flow id="p2_E_W"   type="auto" from="E_C3"  to="RW_W"  begin="1800" end="3600" period="exp(0.151269752197)" departLane="best"/>
    <flow id="p2_NR_W"  type="auto" from="NR_RN" to="RW_W"  begin="1800" end="3600" period="exp(0.0349084043531)" departLane="best"/>
    <flow id="p2_E_SR"  type="auto" from="E_C3"  to="RS_SR" begin="1800" end="3600" period="exp(0.0186178156549)" departLane="best"/>
    <flow id="p2_N1_S1" type="auto" from="N1_C1" to="C1_S1" begin="1800" end="3600" period="exp(0.0349084043531)" departLane="best"/>
    <flow id="p2_S1_N1" type="auto" from="S1_C1" to="C1_N1" begin="1800" end="3600" period="exp(0.0349084043531)" departLane="best"/>
    <flow id="p2_N2_S2" type="auto" from="N2_C2" to="C2_S2" begin="1800" end="3600" period="exp(0.0349084043531)" departLane="best"/>
    <flow id="p2_S2_N2" type="auto" from="S2_C2" to="C2_N2" begin="1800" end="3600" period="exp(0.0349084043531)" departLane="best"/>
    <flow id="p2_N3_S3" type="auto" from="N3_C3" to="C3_S3" begin="1800" end="3600" period="exp(0.0349084043531)" departLane="best"/>
    <flow id="p2_S3_N3" type="auto" from="S3_C3" to="C3_N3" begin="1800" end="3600" period="exp(0.0349084043531)" departLane="best"/>
    <flow id="p2_N1_W"  type="auto" from="N1_C1" to="RW_W"  begin="1800" end="3600" period="exp(0.0139633617412)" departLane="best"/>
    <flow id="p2_S3_E"  type="auto" from="S3_C3" to="C3_E"  begin="1800" end="3600" period="exp(0.0139633617412)" departLane="best"/>
</routes>
