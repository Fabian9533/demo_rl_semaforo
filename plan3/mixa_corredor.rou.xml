<routes>
    <!-- mixa_corredor (plan 3; lo escribe demanda_estocastica.py preparar3, no editar a mano): corredor.rou.xml con llegadas de Poisson (vehsPerHour q pasa a period exp(q/3600); mismo begin y end); mezcla de Lima (vTypeDistribution auto: JICA 2013 sin camiones y flota ATU 2021) con los mismos vehiculos equivalentes del INVERMET (tasas x 0.837802 = 1/1.193600); arranque lento: startupDelay 0.5 s en todos los tipos (solo para evaluar); entrada por el mejor carril (departLane best en cada flow). -->
    <vTypeDistribution id="auto">
        <vType id="lima_auto" accel="2.6" decel="4.5" length="5" sigma="0.5" minGap="2.5" maxSpeed="13.89" startupDelay="0.5" probability="0.789283"/>
        <vType id="lima_moto" vClass="motorcycle" accel="6" decel="10" length="2.2" sigma="0.5" minGap="2.5" maxSpeed="13.89" startupDelay="0.5" probability="0.043643"/>
        <vType id="lima_combi" vClass="bus" accel="2" decel="4.5" length="6" sigma="0.5" minGap="2.5" maxSpeed="13.89" startupDelay="0.5" probability="0.048078"/>
        <vType id="lima_micro" vClass="bus" accel="1.5" decel="4" length="8" sigma="0.5" minGap="2.5" maxSpeed="13.89" startupDelay="0.5" probability="0.056413"/>
        <vType id="lima_bus" vClass="bus" accel="1.2" decel="4" length="12" sigma="0.5" minGap="2.5" maxSpeed="13.89" startupDelay="0.5" probability="0.062584"/>
    </vTypeDistribution>

    <!-- Periodo 1 (0-1800 s): hora punta de oeste a este a lo largo del corredor -->
    <flow id="p1_W_E"   type="auto" from="W_C1"  to="C2_E"  begin="0" end="1800" period="exp(0.139633617412)" departLane="best"/>
    <flow id="p1_E_W"   type="auto" from="E_C2"  to="C1_W"  begin="0" end="1800" period="exp(0.0581806739217)" departLane="best"/>
    <flow id="p1_N1_S1" type="auto" from="N1_C1" to="C1_S1" begin="0" end="1800" period="exp(0.0418900852236)" departLane="best"/>
    <flow id="p1_S1_N1" type="auto" from="S1_C1" to="C1_N1" begin="0" end="1800" period="exp(0.0418900852236)" departLane="best"/>
    <flow id="p1_N2_S2" type="auto" from="N2_C2" to="C2_S2" begin="0" end="1800" period="exp(0.0418900852236)" departLane="best"/>
    <flow id="p1_S2_N2" type="auto" from="S2_C2" to="C2_N2" begin="0" end="1800" period="exp(0.0418900852236)" departLane="best"/>
    <flow id="p1_S1_E"  type="auto" from="S1_C1" to="C2_E"  begin="0" end="1800" period="exp(0.0139633617412)" departLane="best"/>
    <flow id="p1_E_N1"  type="auto" from="E_C2"  to="C1_N1" begin="0" end="1800" period="exp(0.0139633617412)" departLane="best"/>
    <flow id="p1_W_S2"  type="auto" from="W_C1"  to="C2_S2" begin="0" end="1800" period="exp(0.0139633617412)" departLane="best"/>
    <flow id="p1_N2_W"  type="auto" from="N2_C2" to="C1_W"  begin="0" end="1800" period="exp(0.0139633617412)" departLane="best"/>

    <!-- Periodo 2 (1800-3600 s): la punta se invierte, de este a oeste -->
    <flow id="p2_W_E"   type="auto" from="W_C1"  to="C2_E"  begin="1800" end="3600" period="exp(0.0581806739217)" departLane="best"/>
    <flow id="p2_E_W"   type="auto" from="E_C2"  to="C1_W"  begin="1800" end="3600" period="exp(0.139633617412)" departLane="best"/>
    <flow id="p2_N1_S1" type="auto" from="N1_C1" to="C1_S1" begin="1800" end="3600" period="exp(0.0418900852236)" departLane="best"/>
    <flow id="p2_S1_N1" type="auto" from="S1_C1" to="C1_N1" begin="1800" end="3600" period="exp(0.0418900852236)" departLane="best"/>
    <flow id="p2_N2_S2" type="auto" from="N2_C2" to="C2_S2" begin="1800" end="3600" period="exp(0.0418900852236)" departLane="best"/>
    <flow id="p2_S2_N2" type="auto" from="S2_C2" to="C2_N2" begin="1800" end="3600" period="exp(0.0418900852236)" departLane="best"/>
    <flow id="p2_S2_W"  type="auto" from="S2_C2" to="C1_W"  begin="1800" end="3600" period="exp(0.0139633617412)" departLane="best"/>
    <flow id="p2_W_N1"  type="auto" from="W_C1"  to="C1_N1" begin="1800" end="3600" period="exp(0.0139633617412)" departLane="best"/>
    <flow id="p2_E_S1"  type="auto" from="E_C2"  to="C1_S1" begin="1800" end="3600" period="exp(0.0139633617412)" departLane="best"/>
    <flow id="p2_N1_E"  type="auto" from="N1_C1" to="C2_E"  begin="1800" end="3600" period="exp(0.0139633617412)" departLane="best"/>
</routes>
