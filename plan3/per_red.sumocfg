<configuration>
    <!-- per_red (plan 3; lo escribe demanda_estocastica.py preparar3): red.sumocfg con la demanda de per_red.rou.xml; la red y el programa fijo son los del caso. -->
    <input>
        <net-file value="red.net.xml" />
        <route-files value="per_red.rou.xml" />
        <additional-files value="red.add.xml" />
    </input>
    <time>
        <begin value="0" />
        <step-length value="1" />
    </time>
    <processing>
        <time-to-teleport value="-1" />
    </processing>
    <report>
        <no-step-log value="true" />
        <no-warnings value="true" />
    </report>
</configuration>
