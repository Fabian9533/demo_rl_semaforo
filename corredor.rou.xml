<routes>
    <vType id="auto" accel="2.6" decel="4.5" sigma="0.5" length="5" minGap="2.5" maxSpeed="13.89"/>

    <!-- Periodo 1 (0-1800 s): hora punta de oeste a este a lo largo del corredor -->
    <flow id="p1_W_E"   type="auto" from="W_C1"  to="C2_E"  begin="0" end="1800" vehsPerHour="600"/>
    <flow id="p1_E_W"   type="auto" from="E_C2"  to="C1_W"  begin="0" end="1800" vehsPerHour="250"/>
    <flow id="p1_N1_S1" type="auto" from="N1_C1" to="C1_S1" begin="0" end="1800" vehsPerHour="180"/>
    <flow id="p1_S1_N1" type="auto" from="S1_C1" to="C1_N1" begin="0" end="1800" vehsPerHour="180"/>
    <flow id="p1_N2_S2" type="auto" from="N2_C2" to="C2_S2" begin="0" end="1800" vehsPerHour="180"/>
    <flow id="p1_S2_N2" type="auto" from="S2_C2" to="C2_N2" begin="0" end="1800" vehsPerHour="180"/>
    <flow id="p1_S1_E"  type="auto" from="S1_C1" to="C2_E"  begin="0" end="1800" vehsPerHour="60"/>
    <flow id="p1_E_N1"  type="auto" from="E_C2"  to="C1_N1" begin="0" end="1800" vehsPerHour="60"/>
    <flow id="p1_W_S2"  type="auto" from="W_C1"  to="C2_S2" begin="0" end="1800" vehsPerHour="60"/>
    <flow id="p1_N2_W"  type="auto" from="N2_C2" to="C1_W"  begin="0" end="1800" vehsPerHour="60"/>

    <!-- Periodo 2 (1800-3600 s): la punta se invierte, de este a oeste -->
    <flow id="p2_W_E"   type="auto" from="W_C1"  to="C2_E"  begin="1800" end="3600" vehsPerHour="250"/>
    <flow id="p2_E_W"   type="auto" from="E_C2"  to="C1_W"  begin="1800" end="3600" vehsPerHour="600"/>
    <flow id="p2_N1_S1" type="auto" from="N1_C1" to="C1_S1" begin="1800" end="3600" vehsPerHour="180"/>
    <flow id="p2_S1_N1" type="auto" from="S1_C1" to="C1_N1" begin="1800" end="3600" vehsPerHour="180"/>
    <flow id="p2_N2_S2" type="auto" from="N2_C2" to="C2_S2" begin="1800" end="3600" vehsPerHour="180"/>
    <flow id="p2_S2_N2" type="auto" from="S2_C2" to="C2_N2" begin="1800" end="3600" vehsPerHour="180"/>
    <flow id="p2_S2_W"  type="auto" from="S2_C2" to="C1_W"  begin="1800" end="3600" vehsPerHour="60"/>
    <flow id="p2_W_N1"  type="auto" from="W_C1"  to="C1_N1" begin="1800" end="3600" vehsPerHour="60"/>
    <flow id="p2_E_S1"  type="auto" from="E_C2"  to="C1_S1" begin="1800" end="3600" vehsPerHour="60"/>
    <flow id="p2_N1_E"  type="auto" from="N1_C1" to="C2_E"  begin="1800" end="3600" vehsPerHour="60"/>
</routes>
