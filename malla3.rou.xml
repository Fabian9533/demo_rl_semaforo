<routes>
    <!-- Demanda 1.0x de la malla 3x3 (plan v2), el patron del prototipo del 18.09: por fila,
         avenida E-O con 600 veh/h W->E y 250 E->W de 0 a 1800 s, invertido de 1800 a 3600 s; por
         columna, 180 veh/h N->S y 180 S->N; y 12 flujos de giro de 60 veh/h por periodo.
         Total 4350 veh/h en cada periodo. vType igual al de corredor.rou.xml.
         La fila 2 es la avenida de referencia: sus flows de punta a punta usan los ids del
         corredor (p1_W_E, p1_E_W, p2_W_E, p2_E_W) para que comun.leer_tripinfo mida con ellos
         el viaje extremo a extremo y la punta (comun.FLUJOS_PUNTA) igual que en corredor y red. -->
    <vType id="auto" accel="2.6" decel="4.5" sigma="0.5" length="5" minGap="2.5" maxSpeed="13.89"/>

    <!-- Periodo 1 (0-1800 s): punta W->E en las tres filas -->
    <flow id="p1_W1_E1" type="auto" from="W1_C11" to="C13_E1" begin="0" end="1800" vehsPerHour="600"/>
    <flow id="p1_E1_W1" type="auto" from="E1_C13" to="C11_W1" begin="0" end="1800" vehsPerHour="250"/>
    <flow id="p1_W_E" type="auto" from="W2_C21" to="C23_E2" begin="0" end="1800" vehsPerHour="600"/>
    <flow id="p1_E_W" type="auto" from="E2_C23" to="C21_W2" begin="0" end="1800" vehsPerHour="250"/>
    <flow id="p1_W3_E3" type="auto" from="W3_C31" to="C33_E3" begin="0" end="1800" vehsPerHour="600"/>
    <flow id="p1_E3_W3" type="auto" from="E3_C33" to="C31_W3" begin="0" end="1800" vehsPerHour="250"/>
    <flow id="p1_N1_S1" type="auto" from="N1_C11" to="C31_S1" begin="0" end="1800" vehsPerHour="180"/>
    <flow id="p1_S1_N1" type="auto" from="S1_C31" to="C11_N1" begin="0" end="1800" vehsPerHour="180"/>
    <flow id="p1_N2_S2" type="auto" from="N2_C12" to="C32_S2" begin="0" end="1800" vehsPerHour="180"/>
    <flow id="p1_S2_N2" type="auto" from="S2_C32" to="C12_N2" begin="0" end="1800" vehsPerHour="180"/>
    <flow id="p1_N3_S3" type="auto" from="N3_C13" to="C33_S3" begin="0" end="1800" vehsPerHour="180"/>
    <flow id="p1_S3_N3" type="auto" from="S3_C33" to="C13_N3" begin="0" end="1800" vehsPerHour="180"/>
    <flow id="p1_W1_S1" type="auto" from="W1_C11" to="C31_S1" begin="0" end="1800" vehsPerHour="60"/>
    <flow id="p1_S1_E1" type="auto" from="S1_C31" to="C13_E1" begin="0" end="1800" vehsPerHour="60"/>
    <flow id="p1_E1_N3" type="auto" from="E1_C13" to="C13_N3" begin="0" end="1800" vehsPerHour="60"/>
    <flow id="p1_N3_W1" type="auto" from="N3_C13" to="C11_W1" begin="0" end="1800" vehsPerHour="60"/>
    <flow id="p1_W2_S2" type="auto" from="W2_C21" to="C32_S2" begin="0" end="1800" vehsPerHour="60"/>
    <flow id="p1_S2_E2" type="auto" from="S2_C32" to="C23_E2" begin="0" end="1800" vehsPerHour="60"/>
    <flow id="p1_E2_N2" type="auto" from="E2_C23" to="C12_N2" begin="0" end="1800" vehsPerHour="60"/>
    <flow id="p1_N2_W2" type="auto" from="N2_C12" to="C21_W2" begin="0" end="1800" vehsPerHour="60"/>
    <flow id="p1_W3_S3" type="auto" from="W3_C31" to="C33_S3" begin="0" end="1800" vehsPerHour="60"/>
    <flow id="p1_S3_E3" type="auto" from="S3_C33" to="C33_E3" begin="0" end="1800" vehsPerHour="60"/>
    <flow id="p1_E3_N1" type="auto" from="E3_C33" to="C11_N1" begin="0" end="1800" vehsPerHour="60"/>
    <flow id="p1_N1_W3" type="auto" from="N1_C11" to="C31_W3" begin="0" end="1800" vehsPerHour="60"/>

    <!-- Periodo 2 (1800-3600 s): punta E->W en las tres filas -->
    <flow id="p2_W1_E1" type="auto" from="W1_C11" to="C13_E1" begin="1800" end="3600" vehsPerHour="250"/>
    <flow id="p2_E1_W1" type="auto" from="E1_C13" to="C11_W1" begin="1800" end="3600" vehsPerHour="600"/>
    <flow id="p2_W_E" type="auto" from="W2_C21" to="C23_E2" begin="1800" end="3600" vehsPerHour="250"/>
    <flow id="p2_E_W" type="auto" from="E2_C23" to="C21_W2" begin="1800" end="3600" vehsPerHour="600"/>
    <flow id="p2_W3_E3" type="auto" from="W3_C31" to="C33_E3" begin="1800" end="3600" vehsPerHour="250"/>
    <flow id="p2_E3_W3" type="auto" from="E3_C33" to="C31_W3" begin="1800" end="3600" vehsPerHour="600"/>
    <flow id="p2_N1_S1" type="auto" from="N1_C11" to="C31_S1" begin="1800" end="3600" vehsPerHour="180"/>
    <flow id="p2_S1_N1" type="auto" from="S1_C31" to="C11_N1" begin="1800" end="3600" vehsPerHour="180"/>
    <flow id="p2_N2_S2" type="auto" from="N2_C12" to="C32_S2" begin="1800" end="3600" vehsPerHour="180"/>
    <flow id="p2_S2_N2" type="auto" from="S2_C32" to="C12_N2" begin="1800" end="3600" vehsPerHour="180"/>
    <flow id="p2_N3_S3" type="auto" from="N3_C13" to="C33_S3" begin="1800" end="3600" vehsPerHour="180"/>
    <flow id="p2_S3_N3" type="auto" from="S3_C33" to="C13_N3" begin="1800" end="3600" vehsPerHour="180"/>
    <flow id="p2_E1_S1" type="auto" from="E1_C13" to="C31_S1" begin="1800" end="3600" vehsPerHour="60"/>
    <flow id="p2_S1_W1" type="auto" from="S1_C31" to="C11_W1" begin="1800" end="3600" vehsPerHour="60"/>
    <flow id="p2_W1_N3" type="auto" from="W1_C11" to="C13_N3" begin="1800" end="3600" vehsPerHour="60"/>
    <flow id="p2_N3_E1" type="auto" from="N3_C13" to="C13_E1" begin="1800" end="3600" vehsPerHour="60"/>
    <flow id="p2_E2_S2" type="auto" from="E2_C23" to="C32_S2" begin="1800" end="3600" vehsPerHour="60"/>
    <flow id="p2_S2_W2" type="auto" from="S2_C32" to="C21_W2" begin="1800" end="3600" vehsPerHour="60"/>
    <flow id="p2_W2_N2" type="auto" from="W2_C21" to="C12_N2" begin="1800" end="3600" vehsPerHour="60"/>
    <flow id="p2_N2_E2" type="auto" from="N2_C12" to="C23_E2" begin="1800" end="3600" vehsPerHour="60"/>
    <flow id="p2_E3_S3" type="auto" from="E3_C33" to="C33_S3" begin="1800" end="3600" vehsPerHour="60"/>
    <flow id="p2_S3_W3" type="auto" from="S3_C33" to="C31_W3" begin="1800" end="3600" vehsPerHour="60"/>
    <flow id="p2_W3_N1" type="auto" from="W3_C31" to="C11_N1" begin="1800" end="3600" vehsPerHour="60"/>
    <flow id="p2_N1_E3" type="auto" from="N1_C11" to="C33_E3" begin="1800" end="3600" vehsPerHour="60"/>
</routes>
