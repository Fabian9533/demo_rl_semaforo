<routes>
    <!-- dem_corredor_t2715_der: copia de dem_corredor_t2715.rou.xml con los giros del periodo 2 a la derecha (ver el comentario del periodo 2). Origen: dem_corredor_t2715 (niveles de demanda, 22.10.2026): la demanda de corredor.rou.xml con cada vehsPerHour x 1.500000, redondeado a entero sin cambiar el total de cada periodo (2715 veh/h; barrido_demanda.py preparar2). Los demas comentarios de este archivo son los de corredor.rou.xml y describen la demanda base (f = 1). -->
    <vType id="auto" accel="2.6" decel="4.5" sigma="0.5" length="5" minGap="2.5" maxSpeed="13.89"/>

    <!-- Periodo 1 (0-1800 s): hora punta de oeste a este a lo largo del corredor -->
    <flow id="p1_W_E"   type="auto" from="W_C1"  to="C2_E"  begin="0" end="1800" vehsPerHour="900"/>
    <flow id="p1_E_W"   type="auto" from="E_C2"  to="C1_W"  begin="0" end="1800" vehsPerHour="375"/>
    <flow id="p1_N1_S1" type="auto" from="N1_C1" to="C1_S1" begin="0" end="1800" vehsPerHour="270"/>
    <flow id="p1_S1_N1" type="auto" from="S1_C1" to="C1_N1" begin="0" end="1800" vehsPerHour="270"/>
    <flow id="p1_N2_S2" type="auto" from="N2_C2" to="C2_S2" begin="0" end="1800" vehsPerHour="270"/>
    <flow id="p1_S2_N2" type="auto" from="S2_C2" to="C2_N2" begin="0" end="1800" vehsPerHour="270"/>
    <flow id="p1_S1_E"  type="auto" from="S1_C1" to="C2_E"  begin="0" end="1800" vehsPerHour="90"/>
    <flow id="p1_E_N1"  type="auto" from="E_C2"  to="C1_N1" begin="0" end="1800" vehsPerHour="90"/>
    <flow id="p1_W_S2"  type="auto" from="W_C1"  to="C2_S2" begin="0" end="1800" vehsPerHour="90"/>
    <flow id="p1_N2_W"  type="auto" from="N2_C2" to="C1_W"  begin="0" end="1800" vehsPerHour="90"/>

    <!-- Periodo 2 (1800-3600 s): la punta se invierte, de este a oeste -->
    <flow id="p2_W_E"   type="auto" from="W_C1"  to="C2_E"  begin="1800" end="3600" vehsPerHour="375"/>
    <flow id="p2_E_W"   type="auto" from="E_C2"  to="C1_W"  begin="1800" end="3600" vehsPerHour="900"/>
    <flow id="p2_N1_S1" type="auto" from="N1_C1" to="C1_S1" begin="1800" end="3600" vehsPerHour="270"/>
    <flow id="p2_S1_N1" type="auto" from="S1_C1" to="C1_N1" begin="1800" end="3600" vehsPerHour="270"/>
    <flow id="p2_N2_S2" type="auto" from="N2_C2" to="C2_S2" begin="1800" end="3600" vehsPerHour="270"/>
    <flow id="p2_S2_N2" type="auto" from="S2_C2" to="C2_N2" begin="1800" end="3600" vehsPerHour="270"/>
    <!-- Contrafactual (Enmienda 3 del diagnostico del corredor, 25.10.2026): en el periodo 2 los cuatro giros a la
         izquierda de dem_corredor_t2715 (S2->W, W->N1, E->S1 y N1->E) se cambian por los cuatro giros a la derecha
         del periodo 1 (S1->E, E->N1, W->S2 y N2->W), con el mismo volumen. Asi el periodo 2 es la imagen girada 180
         grados del periodo 1, como lo es en flujos de avenida y transversales. Nada mas cambia. -->
    <flow id="p2_S1_E"  type="auto" from="S1_C1" to="C2_E"  begin="1800" end="3600" vehsPerHour="90"/>
    <flow id="p2_E_N1"  type="auto" from="E_C2"  to="C1_N1" begin="1800" end="3600" vehsPerHour="90"/>
    <flow id="p2_W_S2"  type="auto" from="W_C1"  to="C2_S2" begin="1800" end="3600" vehsPerHour="90"/>
    <flow id="p2_N2_W"  type="auto" from="N2_C2" to="C1_W"  begin="1800" end="3600" vehsPerHour="90"/>
</routes>
