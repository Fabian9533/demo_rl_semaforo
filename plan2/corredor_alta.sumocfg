<configuration>
    <input>
        <net-file value="corredor.net.xml"/>
        <route-files value="corredor_alta.rou.xml"/>
        <additional-files value="corredor_alta.add.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <step-length value="1"/>
    </time>
    <processing>
        <time-to-teleport value="-1"/>
    </processing>
    <report>
        <no-step-log value="true"/>
        <no-warnings value="true"/>
    </report>
</configuration>
