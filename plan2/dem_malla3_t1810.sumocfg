<configuration>
    <input>
        <net-file value="malla3.net.xml" />
        <route-files value="dem_malla3_t1810.rou.xml" />
        <additional-files value="dem_malla3_t1810.add.xml" />
    </input>
    <time>
        <begin value="0" />
        <step-length value="1" />
    </time>
    <processing>
        <time-to-teleport value="-1" />
    </processing>
    <report>
        <no-step-log value="true" />
        <no-warnings value="true" />
    </report>
</configuration>